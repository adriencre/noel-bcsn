# Server-side only. Set these in Netlify > Environment variables.
ADMIN_PASSWORD=
SESSION_SECRET=
# Mail de confirmation automatique (SMTP de la boîte qui envoie, ex. Gmail : smtp.gmail.com + mot de passe d'application)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tournoi BCSN <adresse@exemple.fr>
ORGANIZER_EMAIL=
# Optional public event information
EVENT_DATE=
EVENT_LOCATION=
# Catégories fixées dans le code : U11 et U13 uniquement.
